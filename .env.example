# ===============================================
# ANDES FRUITS - ENVIRONMENT VARIABLES
# ===============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores placeholder con tus credenciales reales
# 3. NUNCA subas el archivo .env al repositorio
# 4. Mantén este archivo actualizado cuando agregues nuevas variables
#

# ===============================================
# WEB3FORMS API
# ===============================================
# API key para el servicio de formularios Web3Forms
# Obtén tu key en: https://web3forms.com/
VITE_WEB3FORMS_ACCESS_KEY=your_api_key_here

# ===============================================
# EMAIL CONFIGURATION (Si se usa en backend)
# ===============================================
# Credenciales de email para notificaciones
EMAIL=your_email@example.com
PASSWORD=your_app_password_here

# ===============================================
# OPTIONAL APIs
# ===============================================
# URL base de la API (si aplica)
VITE_API_URL=https://api.andesfruits.com

# Google Maps API Key (si se requiere)
VITE_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ===============================================
# ANALYTICS & MONITORING (Futuro)
# ===============================================
# VITE_GA_TRACKING_ID=your_ga_tracking_id
# VITE_SENTRY_DSN=your_sentry_dsn
